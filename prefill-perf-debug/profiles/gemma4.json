{
  "profile_version": 1,
  "model": "gemma4-31b",
  "description": "Gemma4-31B chunked prefill on a BH Galaxy. 60 layers = 50 sliding (local) + 10 full attention (global).",
  "tree": "/data/kmabee/tt-metal-2",
  "branch_expected": "kmabee/gemma4-swa-multihop-halo",
  "env_file": "/data/kmabee/gemma4_runs/env.sh",
  "python": "{tree}/python_env/bin/python3",
  "mesh": {
    "id": "8x4",
    "cp": 8,
    "tp": 4,
    "arch": "blackhole"
  },
  "layers": {
    "total": 60,
    "types": {
      "global": {
        "count": 10,
        "hf_name": "full_attention",
        "note": "owns the entire prefix term"
      },
      "local": {
        "count": 50,
        "hf_name": "sliding_attention",
        "note": "context-invariant; owns ~84% of the floor by count"
      }
    }
  },
  "chunk_sizes": [
    2048,
    4096,
    8192,
    16384,
    32768
  ],
  "legality": {
    "min_chunk": 1024,
    "rule": "chunk >= 1024 and context_len % chunk == 0",
    "note": "sliding_halo_hop_count = ceil(window/(chunk/cp)) must be <= cp; window=1024, cp=8 -> floor is chunk>=1024 (models/demos/gemma4_d_p/tt/model.py:152)"
  },
  "e2e": {
    "test_file": "models/demos/gemma4_d_p/demo/text_demo_prefill.py",
    "test_name": "test_prefill_long_context_traced",
    "node_id": "blackhole-readback_final-ctx_{ctx_k}k-chunk{chunk}-text-{mesh}",
    "default_ctx": 32768,
    "per_chunk_re": "\\[traced_perf\\] chunk (?P<i>\\d+)/(?P<n>\\d+) \\[(?P<start>\\d+), (?P<end>\\d+)\\) device=(?P<ms>[0-9.]+)ms",
    "summary_re": "\\[traced_perf\\] DEVICE (?P<tokens>\\d+) tokens in (?P<device_s>[0-9.]+)s \\((?P<tok_s>\\d+) tok/s\\) \\| staging (?P<staging_s>[0-9.]+)s \\| readback (?P<readback_s>[0-9.]+)s",
    "separates_device_staging_readback": true,
    "minutes_per_point": 3
  },
  "layer_bench": {
    "test_file": "models/demos/gemma4_d_p/demo/text_demo_prefill.py",
    "test_name": "test_prefill_layer_perf_chunk_n",
    "node_id": "blackhole-chunk{idx}-{layer_type}-sz{chunk}-ctx_{ctx_k}k-{mesh}",
    "layer_type_values": [
      "global",
      "local",
      "both",
      "all"
    ],
    "default_ctx": 262144,
    "result_re": "\\[layer_perf_chunk\\] RESULT type=(?P<lt>\\w+) chunk=(?P<idx>\\d+) ring_depth=\\d+ kv_actual_global=(?P<kv>\\d+) measured_ms=(?P<ms>[0-9.]+)",
    "fake_depth_field": "kv_actual_global",
    "signpost": "gemma4-layer-{layer_type}-chunk{idx}-{phase}",
    "signpost_phases": [
      "start",
      "stop"
    ],
    "sliding_is_called": "local",
    "minutes_per_point": 3,
    "minutes_per_capture": 12,
    "gb_per_capture": 5
  },
  "layer_count_override": {
    "available": false,
    "reason": "no env knob; num_hidden_layers is read from the HF config and validate_31b_config() (tt/model_config.py) hard-rejects a changed value. Layer-count differencing needs a temporary patch -> assisted path only.",
    "sites": [
      "models/demos/gemma4_d_p/tt/model_config.py:validate_31b_config",
      "models/demos/gemma4_d_p/tt/common.py:63"
    ]
  },
  "growing_op": {
    "name": "RingJointSDPADeviceOperation",
    "source": "ttnn/cpp/ttnn/operations/transformer/ring_joint_sdpa/device/ring_joint_sdpa_program_factory.cpp",
    "occupancy": {
      "q_chunk": 64,
      "n_q_heads_local": 8,
      "batch": 1,
      "grid_cores": 110,
      "rows_per_device": "chunk/cp",
      "idle_cores_skipped": false,
      "note": "units = B*NH*ceil((chunk/cp)/q_chunk); depth = ceil(units/grid); cores with no unit run padded handshake iterations, so Cores always reads ~114"
    }
  },
  "ablation_catalogue": [
    {
      "knob": "GEMMA4_KV_DTYPE=bfp4",
